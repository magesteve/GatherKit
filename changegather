#!/bin/zsh
#
# changegather
#
# Gathers changed project files into one timestamped text document for
# sharing with AI assistants.
#
# Part of GatherKit
# https://github.com/magesteve/GatherKit
#

set -euo pipefail

readonly VERSION="0.1"

show_help() {
    cat <<'EOF'
changegather

Usage:
  changegather [options]

By default, changegather gathers tracked and untracked files changed in the
current working tree, including staged and unstaged changes.

Options:
  --since REF         Gather files changed since a commit or branch
  --range A..B        Gather files changed across an explicit Git range
  --staged            Gather only staged changes
  --unstaged          Gather only unstaged tracked changes
  --untracked         Gather only untracked files
  --include PATTERN   Include only files whose names match a shell pattern
                      May be supplied more than once
  --exclude PATTERN   Exclude paths matching a shell pattern
                      May be supplied more than once
  --output FILE       Use a specific output filename
  --version           Display the version
  --help              Display this help

Examples:
  changegather
  changegather --since HEAD~3
  changegather --since main
  changegather --range main..feature-branch
  changegather --staged
  changegather --unstaged
  changegather --untracked
  changegather --include "*.swift"
  changegather --exclude "*/Generated/*"
  changegather --output CurrentChanges.txt
EOF
}

typeset -a include_patterns=()
typeset -a exclude_patterns=()

mode="working"
since_ref=""
range_ref=""
output=""

while (( $# > 0 )); do
    case "$1" in
        --since)
            (( $# >= 2 )) || {
                echo "Error: --since requires a Git reference." >&2
                exit 1
            }
            since_ref="$2"
            mode="since"
            shift
            ;;

        --range)
            (( $# >= 2 )) || {
                echo "Error: --range requires a Git range such as main..HEAD." >&2
                exit 1
            }
            range_ref="$2"
            mode="range"
            shift
            ;;

        --staged)
            mode="staged"
            ;;

        --unstaged)
            mode="unstaged"
            ;;

        --untracked)
            mode="untracked"
            ;;

        --include)
            (( $# >= 2 )) || {
                echo "Error: --include requires a filename pattern." >&2
                exit 1
            }
            include_patterns+=("$2")
            shift
            ;;

        --exclude)
            (( $# >= 2 )) || {
                echo "Error: --exclude requires a path pattern." >&2
                exit 1
            }
            exclude_patterns+=("$2")
            shift
            ;;

        --output)
            (( $# >= 2 )) || {
                echo "Error: --output requires a filename." >&2
                exit 1
            }
            output="$2"
            shift
            ;;

        --version)
            echo "changegather ${VERSION}"
            exit 0
            ;;

        --help|-h)
            show_help
            exit 0
            ;;

        *)
            echo "Error: Unknown option: $1" >&2
            echo "Run 'changegather --help' for usage." >&2
            exit 1
            ;;
    esac

    shift
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: changegather must be run inside a Git repository." >&2
    exit 1
fi

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

project=$(basename "$repository_root")
timestamp=$(date +"%Y%m%d-%H%M%S")

if [[ -z "$output" ]]; then
    output="${project}-ChangeGather-${timestamp}.txt"
fi

exclude_patterns+=(
    "$output"
    "./$output"
    "*-CodeGather-*.txt"
    "*-DocGather-*.txt"
    "*-ProjectGather-*.txt"
    "*-ChangeGather-*.txt"
)

matches_includes() {
    local file="$1"
    local name="${file:t}"
    local pattern

    if (( ${#include_patterns[@]} == 0 )); then
        return 0
    fi

    for pattern in "${include_patterns[@]}"; do
        if [[ "$name" == ${~pattern} || "$file" == ${~pattern} ]]; then
            return 0
        fi
    done

    return 1
}

matches_excludes() {
    local file="$1"
    local pattern

    for pattern in "${exclude_patterns[@]}"; do
        if [[ "$file" == ${~pattern} ]]; then
            return 0
        fi
    done

    return 1
}

typeset -a candidates=()

case "$mode" in
    working)
        while IFS= read -r -d $'\0' file; do
            candidates+=("$file")
        done < <(
            {
                git diff --name-only -z
                git diff --cached --name-only -z
                git ls-files --others --exclude-standard -z
            }
        )
        ;;

    staged)
        while IFS= read -r -d $'\0' file; do
            candidates+=("$file")
        done < <(git diff --cached --name-only -z)
        ;;

    unstaged)
        while IFS= read -r -d $'\0' file; do
            candidates+=("$file")
        done < <(git diff --name-only -z)
        ;;

    untracked)
        while IFS= read -r -d $'\0' file; do
            candidates+=("$file")
        done < <(git ls-files --others --exclude-standard -z)
        ;;

    since)
        if ! git rev-parse --verify "$since_ref" >/dev/null 2>&1; then
            echo "Error: Unknown Git reference: $since_ref" >&2
            exit 1
        fi

        while IFS= read -r -d $'\0' file; do
            candidates+=("$file")
        done < <(git diff --name-only -z "${since_ref}...HEAD")
        ;;

    range)
        while IFS= read -r -d $'\0' file; do
            candidates+=("$file")
        done < <(git diff --name-only -z "$range_ref")
        ;;
esac

typeset -A seen=()
typeset -a files=()
typeset -a missing_files=()

for file in "${candidates[@]}"; do
    [[ -n "$file" ]] || continue
    [[ -n "${seen[$file]-}" ]] && continue
    seen[$file]=1

    matches_includes "$file" || continue
    matches_excludes "$file" && continue

    if [[ -f "$file" ]]; then
        files+=("$file")
    else
        missing_files+=("$file")
    fi
done

files=("${(@on)files}")
missing_files=("${(@on)missing_files}")

if (( ${#files[@]} == 0 && ${#missing_files[@]} == 0 )); then
    echo "No matching changed files were found."
    exit 0
fi

git_branch=$(git branch --show-current 2>/dev/null || true)
git_commit=$(git rev-parse --short HEAD 2>/dev/null || true)

case "$mode" in
    working)   selection="working tree: staged, unstaged, and untracked" ;;
    staged)    selection="staged changes only" ;;
    unstaged)  selection="unstaged tracked changes only" ;;
    untracked) selection="untracked files only" ;;
    since)     selection="changes since ${since_ref}" ;;
    range)     selection="Git range ${range_ref}" ;;
esac

{
    echo "======================================================================"
    echo "GatherKit ChangeGather"
    echo "======================================================================"
    echo "Project   : ${project}"
    echo "Generated : $(date)"
    echo "Tool      : changegather ${VERSION}"
    echo "Selection : ${selection}"
    echo "Git Branch: ${git_branch:-detached}"
    echo "Git Commit: ${git_commit}"
    echo "Files     : ${#files[@]}"
    echo "Missing   : ${#missing_files[@]}"
    echo "======================================================================"
    echo
    echo "CHANGED FILE INDEX"
    echo

    for file in "${files[@]}"; do
        echo "$file"
    done

    if (( ${#missing_files[@]} > 0 )); then
        echo
        echo "DELETED OR UNAVAILABLE FILES"
        echo

        for file in "${missing_files[@]}"; do
            echo "$file"
        done
    fi

    echo

    for file in "${files[@]}"; do
        echo "======================================================================"
        echo "FILE: ${file}"
        echo "======================================================================"
        cat "$file"
        echo
        echo
    done
} > "$output"

echo "Created ${output}"
echo "Gathered ${#files[@]} changed files."

if (( ${#missing_files[@]} > 0 )); then
    echo "Recorded ${#missing_files[@]} deleted or unavailable files."
fi

