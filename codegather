#!/bin/zsh
#
# codegather
#
# Gathers source-code and build-configuration files into one timestamped
# text document for sharing with AI assistants.
#
# Part of GatherKit
# https://github.com/magesteve/GatherKit
#

set -euo pipefail

readonly VERSION="0.3"

show_help() {
    cat <<'EOF'
codegather

Usage:
  codegather [options]

Without a language option, codegather gathers every recognized source type.

Language filters:
  --swift            Swift and Metal
  --dart             Dart and Flutter project files
  --cpp              C, C++, Objective-C, and related headers
  --python           Python
  --javascript       JavaScript and TypeScript
  --java             Java and Kotlin
  --rust             Rust
  --go               Go
  --csharp           C#
  --ruby             Ruby
  --php              PHP
  --shell            Shell scripts

Additional options:
  --include PATTERN  Include an additional filename pattern
                     May be supplied more than once
  --exclude PATTERN  Exclude paths matching a shell pattern
                     May be supplied more than once
  --output FILE      Use a specific output filename
  --version          Display the version
  --help             Display this help

Examples:
  codegather
  codegather --dart
  codegather --swift --cpp
  codegather --dart --include "*.arb"
  codegather --include "*.sql" --exclude "*/Generated/*"
  codegather --output CurrentProject.txt
EOF
}

typeset -a all_patterns=(
    "*.swift" "*.metal"
    "*.dart"

    "*.c" "*.cc" "*.cpp" "*.cxx"
    "*.h" "*.hh" "*.hpp" "*.hxx"
    "*.m" "*.mm"

    "*.py" "*.pyw"

    "*.js" "*.jsx" "*.mjs" "*.cjs"
    "*.ts" "*.tsx"

    "*.java" "*.kt" "*.kts"

    "*.rs"
    "*.go"
    "*.cs"
    "*.rb"
    "*.php"

    "*.sh" "*.bash" "*.zsh" "*.fish"

    "*.cmake"
    "CMakeLists.txt"
    "Makefile" "makefile" "GNUmakefile"

    "Package.swift"
    "Package.resolved"

    "pubspec.yaml"
    "pubspec.lock"
    "analysis_options.yaml"

    "*.gradle"
    "*.gradle.kts"
    "build.gradle"
    "settings.gradle"
    "build.gradle.kts"
    "settings.gradle.kts"

    "Cargo.toml"
    "Cargo.lock"

    "go.mod"
    "go.sum"

    "pom.xml"
)

typeset -a selected_patterns=()
typeset -a included_patterns=()
typeset -a excluded_patterns=()

language_filter_selected=false
output=""

add_patterns() {
    selected_patterns+=("$@")
    language_filter_selected=true
}

while (( $# > 0 )); do
    case "$1" in
        --swift)
            add_patterns "*.swift" "*.metal" "Package.swift" "Package.resolved"
            ;;

        --dart|--flutter)
            add_patterns \
                "*.dart" \
                "pubspec.yaml" \
                "pubspec.lock" \
                "analysis_options.yaml"
            ;;

        --cpp|--c|--objective-c)
            add_patterns \
                "*.c" "*.cc" "*.cpp" "*.cxx" \
                "*.h" "*.hh" "*.hpp" "*.hxx" \
                "*.m" "*.mm" \
                "*.cmake" "CMakeLists.txt" \
                "Makefile" "makefile" "GNUmakefile"
            ;;

        --python)
            add_patterns "*.py" "*.pyw"
            ;;

        --javascript|--typescript|--js)
            add_patterns "*.js" "*.jsx" "*.mjs" "*.cjs" "*.ts" "*.tsx"
            ;;

        --java|--kotlin)
            add_patterns \
                "*.java" "*.kt" "*.kts" \
                "*.gradle" "*.gradle.kts" \
                "build.gradle" "settings.gradle" \
                "build.gradle.kts" "settings.gradle.kts" \
                "pom.xml"
            ;;

        --rust)
            add_patterns "*.rs" "Cargo.toml" "Cargo.lock"
            ;;

        --go)
            add_patterns "*.go" "go.mod" "go.sum"
            ;;

        --csharp)
            add_patterns "*.cs"
            ;;

        --ruby)
            add_patterns "*.rb"
            ;;

        --php)
            add_patterns "*.php"
            ;;

        --shell)
            add_patterns "*.sh" "*.bash" "*.zsh" "*.fish"
            ;;

        --include)
            (( $# >= 2 )) || { echo "Error: --include requires a filename pattern." >&2; exit 1; }
            included_patterns+=("$2")
            shift
            ;;

        --exclude)
            (( $# >= 2 )) || { echo "Error: --exclude requires a path pattern." >&2; exit 1; }
            excluded_patterns+=("$2")
            shift
            ;;

        --output)
            (( $# >= 2 )) || { echo "Error: --output requires a filename." >&2; exit 1; }
            output="$2"
            shift
            ;;

        --version)
            echo "codegather ${VERSION}"
            exit 0
            ;;

        --help|-h)
            show_help
            exit 0
            ;;

        *)
            echo "Error: Unknown option: $1" >&2
            echo "Run 'codegather --help' for usage." >&2
            exit 1
            ;;
    esac

    shift
done

if [[ "$language_filter_selected" == false ]]; then
    selected_patterns=("${all_patterns[@]}")
fi

selected_patterns+=("${included_patterns[@]}")

timestamp=$(date +"%Y%m%d-%H%M%S")
project=$(basename "$PWD")

if [[ -z "$output" ]]; then
    output="${project}-codegather-${timestamp}.txt"
fi

excluded_patterns+=("./${output}" "${output}" "*-codegather-*.txt" "*-DocGather-*.txt" "*-ProjectGather-*.txt")

matches_exclusion() {
    local file="$1"
    local pattern

    for pattern in "${excluded_patterns[@]}"; do
        if [[ "$file" == ${~pattern} ]]; then
            return 0
        fi
    done

    return 1
}

typeset -a files=()
local_file=""
local_name=""
local_pattern=""
matched=false

while IFS= read -r -d $'\0' local_file; do
    local_name="${local_file:t}"
    matched=false

    for local_pattern in "${selected_patterns[@]}"; do
        if [[ "$local_name" == ${~local_pattern} ]]; then
            matched=true
            break
        fi
    done

    if [[ "$matched" == true ]] && ! matches_exclusion "$local_file"; then
        files+=("$local_file")
    fi
done < <(
    find . \
        -type d \( \
            -name ".git" -o \
            -name ".build" -o \
            -name "build" -o \
            -name "Build" -o \
            -name "DerivedData" -o \
            -name "Pods" -o \
            -name "node_modules" -o \
            -name "vendor" -o \
            -name ".idea" -o \
            -name ".vscode" -o \
            -name ".dart_tool" -o \
            -name ".pub-cache" \
        \) -prune -o \
        -type f -print0
)

if (( ${#files[@]} == 0 )); then
    echo "No matching source files were found."
    exit 0
fi

files=("${(@on)files}")

{
    echo "======================================================================"
    echo "GatherKit CodeGather"
    echo "======================================================================"
    echo "Project   : ${project}"
    echo "Generated : $(date)"
    echo "Tool      : codegather ${VERSION}"
    echo "Files     : ${#files[@]}"
    echo "======================================================================"
    echo
    echo "FILE INDEX"
    echo

    for local_file in "${files[@]}"; do
        echo "${local_file#./}"
    done

    echo

    for local_file in "${files[@]}"; do
        echo "======================================================================"
        echo "FILE: ${local_file#./}"
        echo "======================================================================"
        cat "$local_file"
        echo
        echo
    done
} > "$output"

echo "Created ${output}"
echo "Gathered ${#files[@]} files."
